# Base de datos PostgreSQL (Supabase o local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tecflow?schema=public"

# Secreto para firmar JWT (mínimo 16 caracteres)
JWT_SECRET="cambia-este-secreto-en-produccion"

# Puerto del API
PORT=4000

# Origen del frontend para CORS
CLIENT_URL="http://localhost:5173"
